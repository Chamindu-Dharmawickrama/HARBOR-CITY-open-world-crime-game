{
  "name": "harbor-city",
  "private": true,
  "version": "0.1.0",
  "description": "HARBOR CITY — an original open-world crime game for the browser.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p e2e/tsconfig.json",
    "lint": "eslint . --max-warnings 0 && prettier --check . && depcruise src --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vite build && playwright test",
    "bench": "node scripts/bench.mjs",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/three": "0.187.0",
    "dependency-cruiser": "18.8.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
